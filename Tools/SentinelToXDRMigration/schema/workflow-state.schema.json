{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel to XDR workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "solution",
    "workflowStatus",
    "createdAt",
    "updatedAt",
    "context",
    "stages"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "description": "Stable run directory identity. Added when initializing or explicitly migrating legacy state; resumption must keep this value."
    },
    "schemaVersion": {
      "const": "1.2.0"
    },
    "solution": {
      "type": "string",
      "description": "Solution-relative location (normally '.'); legacy absolute locations remain readable. Artifact references resolve against the selected solution, not the shell cwd.",
      "minLength": 1
    },
    "workflowStatus": {
      "enum": [
        "inProgress",
        "blocked",
        "failed",
        "completed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceResourceId",
        "versionBump",
        "workflowProfile"
      ],
      "properties": {
        "workspaceResourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenantId": {
          "type": [
            "string",
            "null"
          ]
        },
        "subscriptionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceCustomerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetContextLocked": {
          "type": "boolean"
        },
        "versionBump": {
          "enum": [
            "patch",
            "minor",
            "major",
            "none",
            null
          ]
        },
        "workflowProfile": {
          "enum": [
            "authoring",
            "qualification"
          ]
        },
        "profileSelectionConfirmed": {
          "type": "boolean"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "conversion",
        "validation",
        "packaging",
        "deployment",
        "mockIngestion",
        "alertParity",
        "report"
      ],
      "properties": {
        "discovery": {
          "$ref": "#/$defs/stage"
        },
        "conversion": {
          "$ref": "#/$defs/stage"
        },
        "validation": {
          "$ref": "#/$defs/stage"
        },
        "packaging": {
          "$ref": "#/$defs/stage"
        },
        "deployment": {
          "$ref": "#/$defs/stage"
        },
        "mockIngestion": {
          "$ref": "#/$defs/stage"
        },
        "alertParity": {
          "$ref": "#/$defs/stage"
        },
        "report": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "campaignId",
        "inventorySha256",
        "status",
        "stopReason"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "campaignId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "inventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": ["active", "stopped"]
        },
        "stopReason": {
          "type": ["string", "null"]
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "status",
        "inventorySha256",
        "currentContract",
        "stopReason"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "mode": {
          "const": "yolo"
        },
        "status": {
          "enum": ["active", "stopped", "conflicted"]
        },
        "inventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "currentContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "revision"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^authoring-contracts/[0-9]{6}-[a-f0-9]{64}\\.json$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "stopReason": {
          "type": ["string", "null"]
        }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "lastSuccessful",
        "lastConsumedAction",
        "currentAttempt",
        "releaseActions",
        "pendingReleaseAction"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "lastSuccessful": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/packageAction"
            }
          ]
        },
        "lastConsumedAction": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/packageAction"
            }
          ]
        },
        "currentAttempt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attemptId",
                "attempt",
                "status",
                "requestedVersionBump",
                "effectiveVersionBump",
                "bumpConsumed",
                "packageInputSha256",
                "packageReportSha256",
                "startedAt"
              ],
              "properties": {
                "attemptId": {
                  "type": "string",
                  "format": "uuid"
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "enum": ["running", "passed", "failed", "blocked"]
                },
                "requestedVersionBump": {
                  "enum": ["none", "patch", "minor", "major"]
                },
                "effectiveVersionBump": {
                  "enum": ["none", "patch", "minor", "major"]
                },
                "bumpConsumed": {
                  "type": "boolean"
                },
                "packageInputSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "packageReportSha256": {
                  "type": ["string", "null"],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "startedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "completedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "failure": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "releaseActions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "versionBump",
              "packageInputSha256",
              "selectedAt",
              "status"
            ],
            "properties": {
              "versionBump": {"enum": ["patch", "minor", "major"]},
              "packageInputSha256": {"$ref": "#/$defs/sha256"},
              "selectedAt": {"type": "string", "format": "date-time"},
              "status": {"enum": ["selected", "consumed"]},
              "historicalEvidence": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "pendingReleaseAction": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["versionBump", "packageInputSha256", "selectedAt"],
              "properties": {
                "versionBump": {"enum": ["patch", "minor", "major"]},
                "packageInputSha256": {"$ref": "#/$defs/sha256"},
                "selectedAt": {"type": "string", "format": "date-time"}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedVersionBump",
        "effectiveVersionBump",
        "bumpConsumed",
        "packageInputSha256",
        "attemptId",
        "packageSucceeded"
      ],
      "properties": {
        "requestedVersionBump": {
          "enum": ["none", "patch", "minor", "major"]
        },
        "effectiveVersionBump": {
          "enum": ["none", "patch", "minor", "major"]
        },
        "bumpConsumed": {
          "type": "boolean"
        },
        "packageInputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "packageSucceeded": {
          "type": "boolean"
        },
        "packageReport": {
          "type": "string",
          "minLength": 1
        },
        "packageReportSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packageArtifactsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "attempts",
        "startedAt",
        "completedAt",
        "message",
        "artifacts",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "passed",
            "failed",
            "blocked",
            "notRequired"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
