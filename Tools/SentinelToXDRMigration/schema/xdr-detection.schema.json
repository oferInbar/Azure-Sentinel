{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/Azure-Sentinel/Tools/SentinelToXDRMigration/schema/xdr-detection.schema.json",
  "title": "Defender XDR Custom Detection source",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "kind",
    "resourceType",
    "apiVersion",
    "contentProvenance",
    "properties"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "description": "Independent XDR content release version (>= 3.1.0 and < 4.0.0), not the source Sentinel rule or schema version.",
      "type": "string",
      "pattern": "^3\\.[1-9][0-9]*\\.(0|[1-9][0-9]*)$"
    },
    "kind": {
      "const": "CustomDetection"
    },
    "resourceType": {
      "const": "Microsoft.Security/detectionRules"
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentProvenance": {
      "type": "object",
      "required": [
        "source",
        "conversion"
      ],
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "platform",
            "kind",
            "id",
            "path",
            "querySha256",
            "schedule"
          ]
        },
        "conversion": {
          "type": "object",
          "required": [
            "tool",
            "version",
            "status",
            "reviewRequired",
            "reviewReasons",
            "requiredWorkloads",
            "warnings"
          ]
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "status",
        "queryCondition",
        "schedule",
        "detectionAction"
      ]
    }
  }
}
