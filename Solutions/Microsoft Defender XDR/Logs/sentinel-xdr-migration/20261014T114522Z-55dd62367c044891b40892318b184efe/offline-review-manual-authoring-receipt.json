    {
      "path": "XDR Detections/Credential Access/DoppelPaymerProcDump.yaml",
      "sourceId": "1be34fb9-f81b-47ae-84fb-465e6686d76c",
      "sourceDocumentSha256": "18b49b71f489a00661e7503e22d144560b4db3a6a3c14536962b6748ee81b194",
      "targetQuerySha256": "1cd69fba9cb72ccbf756b8b785e4ffc5c3967ea8f88db7bc3a757f6cd2fa94c6",
